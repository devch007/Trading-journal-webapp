{
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/indianapi/(.*)",
      "destination": "https://dev.indianapi.in/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
